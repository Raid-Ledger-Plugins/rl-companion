{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RL Companion",
  "version": "0.1.0",
  "identifier": "net.gamernight.rlcompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RL Companion",
        "width": 440,
        "height": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQTdGNjNEMkQxRDAwOTgKUldTWUFCMHRQZmFuem5rQWpoNGNkM1VXdEJHbVdoYW1ReHU2bnV4ZzFoVFQ3QW9rRTYxYjlGbjIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
